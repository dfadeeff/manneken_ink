# --- core ---
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./manneken.db
CORS_ORIGINS=http://localhost:3000

# --- auth (Clerk) ---
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Optional: derived from the publishable key when left blank.
CLERK_JWKS_URL=

# Development only. Skips Clerk verification and signs every request in as a
# fixed test parent. Refuses to start if ENVIRONMENT is not "development".
DEV_AUTH_BYPASS=false

# --- model providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# balanced | cost | speed
ROUTER_POLICY=balanced
# Optional pinning, e.g. {"standard": "google:gemini-3.7-flash"}
ROUTER_TIER_OVERRIDES=
